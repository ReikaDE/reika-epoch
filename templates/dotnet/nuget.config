<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- ReikaDE.Avalonia.Wayland, from `just avalonia-feed` in reika-epoch
         (or REIKA_FEED, which CI sets). -->
    <add key="reika" value="%REIKA_FEED%" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="reika">
      <package pattern="ReikaDE.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
