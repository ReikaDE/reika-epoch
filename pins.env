# Versions shared by every Reika DE component. Change them here first, then
# update the components; `just check-pins` reports any that disagree.

# Smithay: ReikaDE/smithay, branch reika/main (upstream base plus Reika's patches).
SMITHAY_GIT=https://github.com/ReikaDE/smithay
SMITHAY_BASE=54cf9c10fe214066f2e69f43784aafde0d921682
SMITHAY_REV=44a119729bc309c435d6c1f715d9479b7df23beb

# Avalonia: upstream packages, plus ReikaDE/Avalonia's standalone
# Avalonia.Wayland (branch reika/main), packed as ReikaDE.Avalonia.Wayland.
AVALONIA_VERSION=12.2.0
AVALONIA_FORK_GIT=https://github.com/ReikaDE/Avalonia
AVALONIA_FORK_REV=21780e0f58d1c56e6e4440b47acfa561f87e7a2b
AVALONIA_WAYLAND_VERSION=12.2.0-reika.1

# Other .NET packages every component should agree on.
NWAYLAND_VERSION=0.11.0
TMDS_DBUS_VERSION=0.94.1

# .NET SDK floor (global.json rolls forward to the newest installed 10.0 band).
DOTNET_SDK=10.0.100

# reika-protocols: set once the repository exists.
PROTOCOLS_REV=
